    url: 'https://www.varsitymanagementllc.com/blank-13',
    stats: [['HT', '6\'3"'], ['WT', '175']],
    honors: ['All State 5A QB', '1st Team All District', 'District 7-5A'],
    offers: [],
    bio: 'An athletic playmaker with quick closing speed, natural pursuit instincts, energy, speed, and upside.',
    image: dajohnHoward,
  },
  {
    name: 'Micah Gifford',
    sport: 'Football',
    role: 'Safety - Baylor University',
    url: 'https://www.varsitymanagementllc.com/blank-4',
    stats: [['HT', '6\'3"'], ['WT', '207'], ['110H', '14.67'], ['400M', '48']],
    honors: ['2025 All-Big 12 First Team Specialist', 'Consensus 3 Star Recruit', 'Texas 5A Track Regional Qualifier'],
    offers: [],
    bio: 'A long, athletic defensive back with size, speed, physicality, coverage range, and proven Big 12 production.',
    image: micahGifford,
  },
  {
    name: 'Dejay Perkins',
    sport: 'Football',
    role: 'Cornerback - McComb High School',
    url: 'https://www.varsitymanagementllc.com/blank-14',
    stats: [['CLASS', '2027'], ['HT', '5\'10"'], ['WT', '170']],
    honors: ['Mississippi 4A First-Team All-State DB', 'Top 10 in Mississippi 4A category', 'Top 2 in Region 7 4A category'],
    offers: [],
    bio: 'A rising two-way playmaker with receiving production, defensive ball skills, speed, versatility, and regional upside.',
    image: dejayPerkins,
  },
];

const services = [
  ['Branding', 'Build a public identity that is clear, credible, and positioned for opportunity.'],
  ['Development', 'Shape athletic, personal, and professional growth around long-term goals.'],
  ['Recruiting', 'Connect talent with the right programs, coaches, and next-step pathways.'],
  ['Finance', 'Give athletes practical guidance for managing new earning potential.'],
  ['NIL', 'Create and manage name, image, and likeness opportunities with discipline.'],
];
---

<BaseLayout
  title="Varsity Management - Athlete Representation"
  description="Varsity Management equips athletes with branding, NIL management, recruiting, development, and financial growth support."
>
  <Header />
  <main id="top" x-data="{}" class="bg-zinc-950 text-white">
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden pt-[116px]">
      <Image
        src={heroFootball}
        alt="Football player at rest, helmet in hand, under stadium light"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        priority
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_center]"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(9,9,11,0.96),rgba(24,24,27,0.72)_46%,rgba(127,29,29,0.38)),linear-gradient(0deg,rgb(9,9,11)_0%,rgba(9,9,11,0.15)_48%)]"></div>

      <div class="mx-auto w-full max-w-7xl px-5 pb-[clamp(40px,7vh,96px)] sm:px-8 lg:px-16">
        <p
          x-intersect.once="$el.classList.add('is-shown')"
          class:list={[reveal, "flex items-center gap-3.5 text-xs font-bold uppercase tracking-[0.32em] text-red-200 before:h-0.5 before:w-7 before:bg-red-700"]}
        >
          Athlete Representation
        </p>
        <h1
          x-intersect.once="$el.classList.add('is-shown')"
          class:list={[reveal, display, "mt-5 -ml-[0.03em] text-[clamp(48px,11.5vw,164px)] font-black uppercase leading-[0.92] tracking-[0.005em] text-white delay-100"]}
        >
          Varsity
          <span class="block text-transparent [-webkit-text-stroke:1.5px_rgba(255,255,255,0.85)]">Management</span>
        </h1>
        <p
          x-intersect.once="$el.classList.add('is-shown')"
          class:list={[reveal, "mt-6 max-w-[460px] text-[clamp(16px,1.6vw,19px)] leading-[1.7] text-zinc-300 delay-200"]}
        >
          From start to finish - every tool an athlete needs to succeed at every level.
        </p>
        <div
          x-intersect.once="$el.classList.add('is-shown')"
          class:list={[reveal, "mt-8 flex flex-wrap gap-3.5 delay-300"]}
        >
          <a href="#athletes" class="inline-flex min-h-12 items-center justify-center bg-red-700 px-7 text-xs font-bold uppercase tracking-[0.18em] text-white transition hover:bg-red-600">
            View Athletes
          </a>
          <a href="#who-we-are" class="inline-flex min-h-12 items-center justify-center px-7 text-xs font-bold uppercase tracking-[0.18em] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.3)] transition hover:bg-white hover:text-zinc-950 hover:shadow-none">
            Learn More
          </a>
        </div>
      </div>

      <div class="border-t border-white/10 bg-zinc-950/60 backdrop-blur">
        <dl class="mx-auto grid max-w-7xl grid-cols-2 px-5 sm:px-8 lg:grid-cols-4 lg:px-16">
          {facts.map(([label, value], index) => (
            <div
              x-intersect.once="$el.classList.add('is-shown')"
              class:list={[reveal, "py-4 pr-6 lg:py-5", index % 2 === 1 ? "border-l border-white/10 pl-6 lg:pl-6" : "", index > 0 ? "lg:border-l lg:border-white/10 lg:pl-6" : ""]}
              style={`transition-delay: ${260 + index * 80}ms`}
            >
              <dt class="text-[10px] font-bold uppercase tracking-[0.26em] text-zinc-400">{label}</dt>
              <dd class="mt-1.5 font-mono text-[15px] tracking-[0.04em] text-white">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="who-we-are" class="scroll-mt-[76px] bg-zinc-50 px-5 py-[clamp(72px,10vw,132px)] text-zinc-950 sm:px-8 lg:px-16">
      <div class="mx-auto grid max-w-7xl gap-[clamp(32px,5vw,80px)] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
        <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "reveal-left"]}>
          <p class="flex items-center gap-3.5 text-xs font-bold uppercase tracking-[0.32em] text-red-700 before:h-0.5 before:w-7 before:bg-red-700">Who We Are</p>
          <h2 class:list={[display, "mt-5 max-w-[12ch] text-[clamp(40px,5.6vw,76px)] font-black uppercase leading-[0.92] tracking-[0.005em] text-zinc-950"]}>
            Built for the next generation of athletes.
          </h2>
        </div>
        <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "reveal-right delay-150"]}>
          <p class="max-w-[60ch] text-[clamp(17px,1.8vw,21px)] leading-[1.85] text-zinc-600">
            With proven success at the highest levels of both sports and business, Varsity Management brings unmatched expertise to developing the next generation of athletes.
            <strong class="font-semibold text-zinc-950">We believe every young athlete deserves more than recognition for who they are today.</strong>
            They need a team that will guide them toward who they want to become - and reveal the potential they may not yet even see within themselves.
          </p>
          <div class="mt-9 flex flex-wrap gap-10 border-t border-zinc-950/10 pt-6">
            {[
              ['Approach', 'Start to finish'],
              ['Focus', 'Long-term growth'],
              ['Background', 'Sports x Business'],
            ].map(([label, value]) => (
              <div
                x-intersect.once="$el.classList.add('is-shown')"
                class:list={[reveal, "reveal-card"]}
                style={`transition-delay: ${120 + [['Approach', 'Start to finish'], ['Focus', 'Long-term growth'], ['Background', 'Sports x Business']].findIndex(([item]) => item === label) * 90}ms`}
              >
                <span class="block text-[10px] font-bold uppercase tracking-[0.26em] text-zinc-500">{label}</span>
                <span class="mt-1.5 block font-mono text-[15px] text-zinc-950">{value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section
      id="athletes"
      x-data={`{ visibleAthletes: 3, athleteTotal: ${athletes.length} }`}
      class="scroll-mt-[76px] bg-zinc-100 px-5 py-[clamp(72px,10vw,132px)] text-zinc-950 sm:px-8 lg:px-16"
    >
      <div class="mx-auto max-w-7xl">
        <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "mb-[clamp(40px,5vw,64px)] flex flex-wrap items-end justify-between gap-8"]}>
          <div>
            <p class="flex items-center gap-3.5 text-xs font-bold uppercase tracking-[0.32em] text-red-700 before:h-0.5 before:w-7 before:bg-red-700">Athletes</p>
            <h2 class:list={[display, "mt-5 text-[clamp(40px,5.6vw,76px)] font-black uppercase leading-[0.92] tracking-[0.005em] text-zinc-950"]}>Featured Roster</h2>
          </div>
          <p class="max-w-[44ch] text-zinc-600">Profiles shaped around performance, recruitment, marketability, and the next opportunity.</p>
        </div>

        <div class="grid gap-[clamp(16px,2vw,24px)] sm:grid-cols-2 lg:grid-cols-3">
          {athletes.map((athlete, index) => (
            <a
              href={athlete.url}
              target="_blank"
              rel="noreferrer"
              x-intersect.once="$el.classList.add('is-shown')"
              x-bind:class={`{ 'max-sm:hidden': ${index} >= visibleAthletes }`}
              class:list={[reveal, "reveal-card group flex flex-col border border-zinc-950/10 bg-white text-inherit no-underline shadow-[0_18px_50px_rgba(9,9,11,0.04)] transition-[opacity,transform,filter,box-shadow,border-color] hover:border-red-700/35 hover:shadow-[0_24px_70px_rgba(9,9,11,0.12)]"]}
              style={`transition-delay: ${(index % 3) * 95}ms`}
            >
              <article class="flex h-full flex-col">
              <div class="relative aspect-[4/4.7] overflow-hidden bg-zinc-950 after:absolute after:inset-0 after:bg-gradient-to-t after:from-black/95 after:via-black/20 after:to-transparent">
                <Image
                  src={athlete.image}
                  alt={`${athlete.name} athlete portrait`}
                  widths={[360, 520, 760, 980]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover object-top opacity-90 transition duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
                <span class:list={[display, "absolute right-4 top-3.5 z-10 text-[44px] font-black leading-none text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,0.55)]"]}>
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="absolute bottom-4 left-5 right-5 z-10">
                  <p class="text-[10px] font-bold uppercase tracking-[0.26em] text-red-200">{athlete.sport}</p>
                  <h3 class:list={[display, "mt-1.5 text-[clamp(26px,2.4vw,32px)] font-black uppercase leading-none tracking-[0.005em] text-white"]}>{athlete.name}</h3>
                </div>
              </div>
              <div class="flex flex-1 flex-col px-5 py-5">
                <p class="text-[15px] font-semibold text-zinc-950">{athlete.role}</p>
                <div class="mt-3.5 flex flex-wrap gap-x-4 gap-y-1 border-y border-zinc-950/10 py-3">
                  {athlete.stats.map(([label, value]) => (
                    <span class="font-mono text-[12.5px] tracking-[0.06em] text-zinc-600">{label} <b class="font-semibold text-zinc-950">{value}</b></span>
                  ))}
                </div>
                <p class="mt-4 text-sm leading-6 text-zinc-600">{athlete.bio}</p>
                {athlete.offers.length > 0 && (
                  <div class="mt-4 border-t border-zinc-950/10 pt-3">
                    <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-red-700">Offers</p>
                    <p class="mt-2 line-clamp-2 text-xs font-semibold uppercase leading-5 tracking-[0.08em] text-zinc-700">
                      {athlete.offers.join(' · ')}
                    </p>
                  </div>
                )}
                <ul class="mt-3.5">
                  {athlete.honors.map((honor) => (
                    <li class="relative py-1 pl-4 text-xs font-semibold uppercase tracking-[0.1em] text-zinc-600 before:absolute before:left-0 before:top-1/2 before:h-0.5 before:w-2 before:-translate-y-1/2 before:bg-red-700">
                      {honor}
                    </li>
                  ))}
                </ul>
                <span class="mt-auto inline-flex pt-5 text-[11px] font-bold uppercase tracking-[0.22em] text-red-700 transition group-hover:translate-x-1">
                  View Profile
                </span>
              </div>
              </article>
            </a>
          ))}
        </div>

        <div class="mt-8 flex justify-center sm:hidden">
          <button
            type="button"
            x-show="visibleAthletes < athleteTotal"
            x-on:click="visibleAthletes = Math.min(visibleAthletes + 3, athleteTotal)"
            class="inline-flex min-h-12 items-center justify-center bg-red-700 px-7 text-xs font-bold uppercase tracking-[0.18em] text-white transition hover:bg-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-100"
          >
            See More Athletes
          </button>
        </div>
      </div>
    </section>

    <div class="overflow-hidden whitespace-nowrap border-y border-white/10 bg-zinc-950 py-5" aria-hidden="true">
      <div class:list={["inline-block animate-[marquee_28s_linear_infinite]", display]}>
        {Array.from({ length: 4 }).map(() => (
          <span class="pr-14 text-[clamp(34px,4.5vw,64px)] font-black uppercase leading-none text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,0.4)]">
            Perform <i class="not-italic text-red-700 [-webkit-text-stroke:0]">&amp;</i> Prosper Without Limits
          </span>
        ))}
      </div>
    </div>

    <section id="services" class="relative isolate scroll-mt-[76px] overflow-hidden px-5 py-[clamp(72px,10vw,132px)] sm:px-8 lg:px-16">
      <Image src={servicesFootball} alt="" widths={[640, 960, 1280]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30" />
      <div class="absolute inset-0 -z-10 bg-zinc-950/80"></div>
      <div class="mx-auto grid max-w-7xl gap-[clamp(40px,6vw,96px)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "reveal-left"]}>
          <p class="flex items-center gap-3.5 text-xs font-bold uppercase tracking-[0.32em] text-red-200 before:h-0.5 before:w-7 before:bg-red-700">Our Services</p>
          <h2 class:list={[display, "mt-5 max-w-[11ch] text-[clamp(40px,5.6vw,76px)] font-black uppercase leading-[0.92] tracking-[0.005em] text-white"]}>
            Talent meets strategic opportunity.
          </h2>
          <p class="mt-6 max-w-[46ch] text-zinc-400">
            Varsity Management is the intersection of athletic talent and strategic opportunity - combining branding, NIL management, recruiting, and financial growth to empower athletes to perform and prosper without limits.
          </p>
        </div>
        <ol class="border-t border-white/10">
          {services.map(([title, text], index) => (
            <li
              x-intersect.once="$el.classList.add('is-shown')"
              class:list={[reveal, "reveal-right grid grid-cols-[48px_1fr] items-baseline gap-x-5 border-b border-white/10 py-6 transition-[opacity,transform,filter,clip-path,background-color] hover:bg-white/[0.045] sm:grid-cols-[72px_minmax(0,0.55fr)_minmax(0,1fr)] sm:pr-3"]}
              style={`transition-delay: ${index * 80}ms`}
            >
              <span class="font-mono text-[13px] tracking-[0.08em] text-red-200">{String(index + 1).padStart(2, '0')}</span>
              <h3 class:list={[display, "text-[clamp(24px,2.4vw,34px)] font-black uppercase leading-none text-white"]}>{title}</h3>
              <p class="col-start-2 mt-3 text-[14.5px] leading-[1.7] text-zinc-400 sm:col-start-auto sm:mt-0">{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="team" class="relative isolate flex min-h-[72svh] scroll-mt-[76px] items-center overflow-hidden px-5 py-[clamp(72px,10vw,132px)] sm:px-8 lg:px-16">
      <Image src={quoteAthlete} alt="Athlete crouched in dramatic training light" widths={[640, 960, 1280, 1600]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_30%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(9,9,11,0.92),rgba(9,9,11,0.5)_55%,rgba(127,29,29,0.45))]"></div>
      <div class="mx-auto w-full max-w-7xl">
        <blockquote x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "reveal-left max-w-[760px]"]}>
          <span aria-hidden="true" class:list={[display, "block h-12 text-[110px] font-black leading-[0.5] text-red-700"]}>"</span>
          <p class:list={[display, "text-[clamp(32px,4.6vw,60px)] font-black uppercase leading-[0.92] tracking-[0.005em] text-white"]}>
            Never say never, because limits, like fears, are often just an illusion.
          </p>
          <footer class="mt-7 flex items-center gap-3.5 text-xs font-bold uppercase tracking-[0.3em] text-red-200 before:h-0.5 before:w-7 before:bg-red-700">
            Michael Jordan
          </footer>
        </blockquote>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
