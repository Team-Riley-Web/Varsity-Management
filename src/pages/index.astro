const athletes = [
  {
    name: 'Ethan Kimmie',
    sport: 'Football',
    role: 'Wide Receiver - Zachary High School',
    url: 'https://www.varsitymanagementllc.com/blank-11',
    stats: [['CLASS', '2027'], ['HT', '6\'4"'], ['WT', '190']],
    honors: ['All-District Basketball', 'Louisiana Freshman Showcase 1st Team', 'Top multi-sport prospect'],
    offers: ['Texas A&M', 'Kentucky', 'Arkansas', 'Syracuse', 'UNLV', 'LA Tech', 'South Alabama', 'USM', 'Florida State', 'West Virginia', 'Grambling State', 'Nicholls State', 'McNeese State', 'ULL'],
    bio: 'A 6’4” playmaker with rare length, vertical-threat ability, contested-catch skills, and two-way versatility.',
    image: ethanKimmie,
  },
  {
    name: 'Triston Naquin',
    sport: 'Basketball',
    role: 'Forward - Archbishop Shaw High School',
    url: 'https://www.varsitymanagementllc.com/blank-8',
    stats: [['CLASS', '2028'], ['HT', '6\'7"'], ['WT', '210']],
    honors: ['D1 Super Sleeper', '4 Star ESPN', '#3 in Louisiana Class of 2027'],
    offers: ['ASU', 'UNLV', 'ULL', 'USF', 'USM'],
    bio: 'A high-upside forward with size, versatility, rebounding presence, shot-blocking impact, and next-level potential.',
    image: tristonNaquin,
  },
  {
    name: 'Kendrick Joseph Jr.',
    sport: 'Football',
    role: 'Defensive Back - St. James High School',
    url: 'https://www.varsitymanagementllc.com/blank-9',
    stats: [['CLASS', '2027'], ['HT', '6\'0"'], ['WT', '170']],
    honors: ['#6 ATH in Prep Redzone LA'],
    offers: ['ODU committed'],
    bio: 'A versatile two-way athlete with physicality, secondary instincts, running back production, and rising Louisiana profile.',
    image: kendrickJoseph,
  },
  {
    name: 'Tucker Wade',
    sport: 'Football',
    role: 'Quarterback - Orange Beach High',
    url: 'https://www.varsitymanagementllc.com/blank-5',
    stats: [['CLASS', '2029'], ['HT', '6\'0"'], ['WT', '180'], ['40', '5.4']],
    honors: ['All Freshman First Team'],
    offers: [],
    bio: 'A young signal-caller with early varsity production, command, accuracy, and dual-threat development upside.',
    image: tuckerWade,
  },
  {
    name: 'Dylan Henry',
    sport: 'Football',
    role: 'Defensive Back - Mandeville High School',
    url: 'https://www.varsitymanagementllc.com/blank-6',
    stats: [['CLASS', '2027'], ['HT', '5\'11"'], ['WT', '170'], ['40', '4.52']],
    honors: ['All Freshman First Team'],
    offers: ['ODU', 'Memphis', 'McNeese', 'South Alabama committed'],
