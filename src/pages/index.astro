const display = "[font-family:'Avenir_Next_Condensed','Helvetica_Neue_Condensed','Arial_Narrow','Roboto_Condensed',sans-serif]";
const reveal = "reveal-luxury will-change-transform transition-[opacity,transform,filter,clip-path] duration-[1100ms] ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none";

const facts = [
  ['Discipline', 'Football · Basketball'],
  ['Service Lines', '05'],
  ['Featured Roster', '11 Athletes'],
  ['Based In', 'Mandeville, LA'],
