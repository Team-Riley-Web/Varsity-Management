---
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import heroFootball from '../assets/images/hero-football.jpg';
import quoteAthlete from '../assets/images/quote-athlete.jpg';
import servicesFootball from '../assets/images/services-football.jpg';
import codyCorales from '../assets/images/athletes/cody-corales.png';
import dajohnHoward from '../assets/images/athletes/dajohn-howard.jpg';
import dejayPerkins from '../assets/images/athletes/dejay-perkins.png';
