    url: 'https://www.varsitymanagementllc.com/blank-10',
    stats: [['CLASS', '2028'], ['HT', '6\'4"'], ['WT', '305']],
    honors: ['Top Offensive Lineman class of 2028'],
    offers: ['Troy University', 'AAMU'],
    bio: 'A developing offensive line prospect growing inside one of Louisiana’s most competitive football programs.',
    image: jordanCollins,
  },
  {
    name: 'Ian Gray',
    sport: 'Football',
    role: 'Middle Linebacker - Edna Karr High School',
    url: 'https://www.varsitymanagementllc.com/blank-12',
    stats: [['HT', '6\'3"'], ['WT', '207']],
    honors: ['Physical downhill defender', 'Multiple linebacker spots'],
