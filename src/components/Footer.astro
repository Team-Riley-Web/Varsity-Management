---
import { AtSign, Mail, MapPin, MessageCircle, Phone, Share2 } from '@lucide/astro';
import logo from '../assets/images/vm-logo.png';
import { Image } from 'astro:assets';
---

<footer id="contact" class="bg-zinc-950 text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-8 lg:grid-cols-[1.15fr_1fr_1fr] lg:py-18">
    <div>
      <Image src={logo} alt="Varsity Management crest logo" width={92} height={92} class="mb-6 h-20 w-20 object-contain" />
      <p class="max-w-sm text-sm leading-7 text-zinc-300">
        Strategic athletic management for brand growth, recruiting guidance, NIL opportunities, and long-term athlete development.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.28em] text-red-400">Info</h2>
      <div class="mt-6 space-y-4 text-sm text-zinc-200">
        <a class="flex items-center gap-3 transition hover:text-red-300" href="tel:15044169318">
          <Phone size={18} /> 504-416-9318
        </a>
        <a class="flex items-center gap-3 transition hover:text-red-300" href="mailto:info@varsitymanagementllc.com">
          <Mail size={18} /> info@varsitymanagementllc.com
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.28em] text-red-400">Address</h2>
      <p class="mt-6 flex gap-3 text-sm leading-7 text-zinc-200">
        <MapPin class="mt-1 shrink-0" size={18} />
        <span>2090 Woodrow St<br />Mandeville LA 70448</span>
      </p>
      <div class="mt-7 flex gap-3" aria-label="Social links">
        <a href="#" aria-label="Varsity Management on X" class="grid h-10 w-10 place-items-center bg-white/10 text-zinc-100 transition hover:bg-red-700">
          <AtSign size={18} />
        </a>
        <a href="#" aria-label="Varsity Management on Instagram" class="grid h-10 w-10 place-items-center bg-white/10 text-zinc-100 transition hover:bg-red-700">
          <MessageCircle size={18} />
        </a>
        <a href="#" aria-label="Varsity Management on Facebook" class="grid h-10 w-10 place-items-center bg-white/10 text-zinc-100 transition hover:bg-red-700">
          <Share2 size={18} />
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 px-5 py-5 text-center text-xs uppercase tracking-[0.2em] text-zinc-500">
    Varsity Management LLC
  </div>
</footer>
