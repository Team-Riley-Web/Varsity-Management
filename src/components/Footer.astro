---
import { X } from '@lucide/astro';
import logo from '../assets/images/vm-logo.png';
import { Image } from 'astro:assets';

const reveal = "reveal-luxury will-change-transform transition-[opacity,transform,filter,clip-path] duration-[1100ms] ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none";
---

<footer id="contact" x-data="{}" class="border-t border-white/10 bg-zinc-950 text-white">
  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-14 pt-20 sm:px-8 lg:grid-cols-[auto_1fr_1fr_auto] lg:items-center lg:gap-x-24 lg:gap-y-8 lg:px-16 lg:pb-24 lg:pt-28">
    <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "flex items-start"]}>
      <Image src={logo} alt="Varsity Management shield crest" class="block h-[150px] w-auto max-w-full object-contain" />
    </div>

    <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "delay-100"]}>
      <h2 class="text-xs font-bold uppercase tracking-[0.28em] text-red-200">Contact</h2>
      <div class="mt-6 flex flex-col font-mono text-sm leading-8 tracking-[0.03em]">
        <a class="w-fit transition hover:text-red-200" href="tel:15044169318">
          504-416-9318
        </a>
        <a class="w-fit transition hover:text-red-200" href="mailto:info@varsitymanagementllc.com">
          info@varsitymanagementllc.com
        </a>
      </div>
    </div>

    <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "delay-200"]}>
      <h2 class="text-xs font-bold uppercase tracking-[0.28em] text-red-200">Address</h2>
      <address class="mt-6 font-mono text-sm not-italic leading-8 tracking-[0.03em] text-white">
        2090 Woodrow St<br />Mandeville LA 70448
      </address>
    </div>

    <div x-intersect.once="$el.classList.add('is-shown')" class:list={[reveal, "delay-300"]}>
      <h2 class="text-xs font-bold uppercase tracking-[0.28em] text-red-200">Social</h2>
      <div class="mt-7 flex gap-2.5" aria-label="Social links">
        <a href="#" aria-label="Varsity Management on X" class="grid h-11 w-11 place-items-center bg-white/[0.08] text-white transition hover:bg-red-700">
          <X size={18} />
        </a>
        <a href="#" aria-label="Varsity Management on Instagram" class="grid h-11 w-11 place-items-center bg-white/[0.08] text-white transition hover:bg-red-700">
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
            <circle cx="12" cy="12" r="4.1" />
            <circle cx="17.2" cy="6.8" r="1.05" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="#" aria-label="Varsity Management on Facebook" class="grid h-11 w-11 place-items-center bg-white/[0.08] text-white transition hover:bg-red-700">
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.87.24-1.46 1.48-1.46h1.58V5.06c-.27-.04-1.2-.11-2.28-.11-2.25 0-3.79 1.37-3.79 3.88V11H8.02v3h2.43v7h3.05z" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</footer>
